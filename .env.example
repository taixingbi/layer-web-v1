# HuntAI web — copy to `.env` or `.env.local` (see README)

# Gateway BFF target (no trailing slash)
GATEWAY_BASE_URL=http://localhost:8000

# Public URL where users open this app (no trailing slash). Required for password-reset redirects.
# Must match gateway FRONTEND_URL and Supabase Dashboard → Authentication → Site URL.
APP_URL=http://192.168.86.179:30186
# Optional public origin for SEO canonical URLs and sitemap (production domain).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Canonical resume PDF URL (prod: https://taixingai.com/resume/Taixing_Bi_Resume.pdf).
# When unset, falls back to NEXT_PUBLIC_SITE_URL or APP_URL + /resume/Taixing_Bi_Resume.pdf
# NEXT_PUBLIC_RESUME_CANONICAL_URL=https://taixingai.com/resume/Taixing_Bi_Resume.pdf
# Admin upload (header Resume link when signed in as admin) writes to public/resume/ via POST /api/admin/resume
# RESUME_PDF_STORAGE_DIR=public/resume
# RESUME_PDF_STORAGE_PATH=/absolute/path/Taixing_Bi_Resume.pdf
# RESUME_PDF_MAX_BYTES=5242880

# Session cookie Secure flag. Default: true only when APP_URL is https://
# Set COOKIE_SECURE=false for HTTP deploys (Docker NODE_ENV=production on LAN).
COOKIE_SECURE=false

# Optional: JSON log field `service` for Next.js API routes
# WEB_SERVICE_NAME=huntai-web

# Optional: debug panel external links ({trace_id} is substituted)
# NEXT_PUBLIC_LANGSMITH_TRACE_URL=https://smith.langchain.com/o/your-org/projects/p/your-project/r/{trace_id}

# Grafana Cloud (default stack: https://taixingbi.grafana.net/)
# NEXT_PUBLIC_GRAFANA_BASE_URL=https://taixingbi.grafana.net
# Loki datasource name in Explore (Grafana Cloud → Connections → Data sources)
# NEXT_PUBLIC_GRAFANA_LOKI_DATASOURCE=grafanacloud-logs
# Full override for trace deep link:
# NEXT_PUBLIC_GRAFANA_TRACE_URL=https://taixingbi.grafana.net/explore?traceId={trace_id}

# httpOnly session cookie max-age after login (seconds). Default 28800 (8h). Max 2592000 (30d).
# AUTH_SESSION_MAX_AGE_SECONDS=28800

# --- Admin dashboard (/admin) ---
# Service URLs for health probes (no trailing slash). GATEWAY_BASE_URL is reused for gateway-api.
# ORCHESTRATOR_BASE_URL=http://192.168.86.179:30184
# RAG_QUERY_BASE_URL=http://192.168.86.179:30183
# INFERENCE_GATEWAY_BASE_URL=http://192.168.86.179:30180
# EMBED_GATEWAY_BASE_URL=http://192.168.86.179:30181
# RERANKER_GATEWAY_BASE_URL=http://192.168.86.179:30182
# QDRANT_BASE_URL=http://192.168.86.179:30633
# REDIS_URL=redis://192.168.86.179:30379
# PROMETHEUS_URL=http://127.0.0.1:9090
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=sb_secret_... (preferred; same as service role for PostgREST)
# Env for rag_eval_runs panel (must match eval --supabase-env and SUPABASE_URL project)
# ADMIN_RAG_EVAL_ENV=prod
# ADMIN_API_KEY=optional-bearer-for-automation
# ADMIN_ROUTER_VERSION=router-v2.00
# ADMIN_ROUTER_ACCURACY=98.4
# ADMIN_ROUTER_EVALUATED_AT=2026-05-01
# ADMIN_INFERENCE_MODEL=qwen2.5-7b
# ADMIN_EMBEDDING_MODEL=BAAI/bge-m3
# ADMIN_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# ADMIN_INFERENCE_RUNTIME=vLLM
# Admin observability + CI/CD pages (external UI links only — uses NEXT_PUBLIC_GRAFANA_* above)
# NEXT_PUBLIC_ADMIN_LOG_NAMESPACE=ai-dev
# NEXT_PUBLIC_LOKI_CLUSTER=k3s
# NEXT_PUBLIC_ARGOCD_UI_URL=https://argocd.taixingai.com
