# huntAI web — copy to `.env` or `.env.local` (see README)

# Gateway BFF target (no trailing slash)
GATEWAY_BASE_URL=http://localhost:8000

# Fallback bearer when the browser sends no Authorization and no session cookie.
# Production JWT: often leave empty for interactive users who sign in via /login or /signup.
GATEWAY_BEARER_TOKEN=demo-token

# Optional: JSON log field `service` for Next.js API routes
# WEB_SERVICE_NAME=huntai-web

# httpOnly session cookie max-age after /login (seconds). Default 28800 (8h). Max 2592000 (30d).
# AUTH_SESSION_MAX_AGE_SECONDS=28800

# Verify token against gateway before setting session cookie (default true). Set false to accept any
# non-empty string without calling the gateway (stub dev only; not recommended for production JWT).
# AUTH_VALIDATE_TOKEN_ON_LOGIN=true

# Optional: URL for browser "Sign up" (IdP self-service registration). Shown on /signup.
# AUTH_SIGNUP_URL=https://your-idp.example.com/self-service/registration

# Optional local demo login (POST /api/auth/demo). Never use real secrets in git.
# AUTH_DEMO_EMAIL=demo@example.com
# AUTH_DEMO_PASSWORD=changeme
# AUTH_DEMO_ACCESS_TOKEN=paste-a-valid-jwt-for-gateway-AUTH_MODE-jwt
